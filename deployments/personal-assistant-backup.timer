# Nightly database backup.
#
#   sudo cp personal-assistant-backup.service personal-assistant-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now personal-assistant-backup.timer

[Unit]
Description=Nightly the assistant database backup

[Timer]
OnCalendar=*-*-* 03:30:00
# Runs on the next boot if the machine was off when it was due.
Persistent=true
# Spreads the load if anything else is scheduled at the same minute.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
