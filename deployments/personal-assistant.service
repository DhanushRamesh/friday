# The personal assistant server, as a service.
#
#   sudo cp personal-assistant.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now personal-assistant

[Unit]
Description=Personal assistant server
Documentation=https://github.com/DhanushRamesh/personal-assistant
# MySQL is on the same machine, and the server refuses to start without it.
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=assistant
Group=assistant
WorkingDirectory=/opt/personal-assistant
ExecStart=/opt/personal-assistant/personal-assistant

# The server drains in-flight requests and lets running chats record where they
# got to, so it is given time to do so rather than being killed outright.
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartSec=5s

# Logs are already structured JSON on stdout; the journal keeps them.
StandardOutput=journal
StandardError=journal

# It needs its own directory, a loopback socket and nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/personal-assistant
# Nothing is served to the outside; Caddy reaches it over loopback.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
