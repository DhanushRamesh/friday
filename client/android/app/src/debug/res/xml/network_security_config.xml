<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  From Android 9 an app cannot use plain HTTP, which is right: FRIDAY's
  tokens are bearer credentials and anyone who reads one becomes that
  client. The deployed server is HTTPS and needs none of this.

  It exists so a debug build can be pointed at a FRIDAY running on the
  same network — a laptop on the desk — which is how anything is tested
  before it is deployed. Private addresses only, so this cannot quietly
  permit plain HTTP to somewhere on the internet.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
