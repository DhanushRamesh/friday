/bin/
/build/
/config.ini
# Anything alongside it holds the same credentials: a backup taken before an
# edit is as dangerous to commit as the file itself.
/config.ini.*
.env
/friday
/friday.log
/.friday.pid

# Flutter client
client/build/
client/.dart_tool/
client/.flutter-plugins-dependencies

# Picovoice: the access key and the wake-word models are tied to an
# account, so they are obtained per machine rather than committed.
/client/.picovoice
/client/assets/wake/*.ppn
